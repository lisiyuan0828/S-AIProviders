{
  "name": "@s-aiproviders/core",
  "version": "0.1.0",
  "description": "Unified AI provider protocol layer: OpenAI-compatible / Anthropic / Gemini chat streaming + image generation (OpenAI-compatible & Tencent Cloud TC3).",
  "license": "MIT",
  "author": "lisiyuan0828",
  "homepage": "https://github.com/lisiyuan0828/S-AIProviders/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lisiyuan0828/S-AIProviders.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/lisiyuan0828/S-AIProviders/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./image-gen": {
      "types": "./dist/image-gen/index.d.ts",
      "import": "./dist/image-gen/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "ai",
    "llm",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "deepseek",
    "kimi",
    "qwen",
    "doubao",
    "zhipu",
    "tokenplan",
    "image-generation",
    "streaming",
    "sse"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
