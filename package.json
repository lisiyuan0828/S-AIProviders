{
  "name": "s-aiproviders",
  "version": "0.1.0",
  "private": true,
  "description": "Unified AI provider abstraction (chat + image-gen) — usable as an npm package or as a portable Skill.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "skill:chat": "tsx skill/scripts/main.ts chat",
    "skill:image": "tsx skill/scripts/main.ts image",
    "skill:list": "tsx skill/scripts/main.ts list-presets"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.0.0"
}
